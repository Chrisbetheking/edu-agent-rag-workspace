generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  consultant
  viewer
}

enum DocumentStatus {
  pending
  parsing
  ready
  failed
}

enum MessageRole {
  user
  assistant
  system
  tool
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         UserRole @default(consultant)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]
  toolCallLogs  ToolCallLog[]
}

model Document {
  id          String         @id @default(cuid())
  title       String
  sourceType  String         @default("upload")
  fileName    String?
  status      DocumentStatus @default(pending)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  tokenCount Int      @default(0)
  metadata   Json?
  // Stage 4: add vector column by pgvector migration.
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  messages Message[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  content   String
  variables Json?
  enabled   Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentTool {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String
  enabled     Boolean  @default(true)
  schema      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs ToolCallLog[]
}

model ToolCallLog {
  id        String   @id @default(cuid())
  userId    String?
  toolId    String?
  input     Json
  output    Json?
  success   Boolean  @default(true)
  latencyMs Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  user User?      @relation(fields: [userId], references: [id])
  tool AgentTool? @relation(fields: [toolId], references: [id])
}

model RagEvalQuestion {
  id              String   @id @default(cuid())
  question        String
  expectedAnswer  String?
  expectedDocRefs Json?
  createdAt       DateTime @default(now())

  results RagEvalResult[]
}

model RagEvalResult {
  id           String   @id @default(cuid())
  questionId   String
  recallAtK    Float?
  hit           Boolean  @default(false)
  latencyMs     Int      @default(0)
  config        Json?
  badCaseNote   String?
  createdAt     DateTime @default(now())

  question RagEvalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
